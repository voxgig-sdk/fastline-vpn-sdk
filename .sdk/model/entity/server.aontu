# Entity: server

main: kit: entity: server: {

  alias: field: {}

  fields: [
    {
      name: "server"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "server"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/ajax/servers"
          parts: [
            "ajax"
            "servers"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
