# Entity: server

main: kit: entity: server: {

  alias: field: {}

  fields: [
    {
      name: "servers"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "success"
      req: false
      short: "Indicates if the request was successful"
      type: "`$BOOLEAN`"
    }
  ]

  name: "server"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/ajax/servers"
          segments: [
            {
              lit: "ajax"
            }
            {
              lit: "servers"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
